<?xml version="1.0"?>
<!--
  BORIS neck + camera mount.

  Joint names match what fbot_hri/fbot_head `neck_controller` publishes on
  /boris_head/joint_states, so robot_state_publisher moves these joints directly:
    horizontal_neck_joint  (pan,  about z)
    vertical_neck_joint    (tilt, about y)

  Frames (parent -> child):
    <parent> -> neck_pan_link -> camera_mount_link -> camera_link
  A second, FIXED copy of the chain ends at `camera_link_static`. It does not
  follow the neck and is used as a reference frame (neck_controller default
  target_frame, infinite_rotate_camera state).

  Usage:
    <xacro:include filename="$(find boris_head_description)/urdf/neck.xacro"/>
    <xacro:neck parent="dorso_link" xyz="..." rpy="0 0 0"/>

  NOTE: the facial joints (jaw, eyes, eyelids, eyebrows) are driven by
  fbot_head emotions_bridge (Arduino) and have no joint-state feedback, so
  they are intentionally not part of this description. The face meshes under
  meshes/dae are still used by fbot_simulation/models/boris.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="neck_part_inertial" params="m">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="1.0e-5" ixy="0" ixz="0" iyy="1.0e-5" iyz="0" izz="1.0e-5"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="neck" params="parent xyz rpy">

    <!-- Moving chain -->
    <link name="neck_pan_link">
      <xacro:neck_part_inertial m="0.018"/>
      <visual>
        <geometry><mesh filename="package://sensors_description/meshes/tilt_link.STL"/></geometry>
        <material name="neck_dark"><color rgba="0.25 0.25 0.25 1"/></material>
      </visual>
      <collision>
        <geometry><mesh filename="package://sensors_description/meshes/tilt_link.STL"/></geometry>
      </collision>
    </link>

    <link name="camera_mount_link">
      <xacro:neck_part_inertial m="0.055"/>
      <visual>
        <geometry><mesh filename="package://sensors_description/meshes/roll_link.STL"/></geometry>
        <material name="neck_light"><color rgba="0.79 0.82 0.93 1"/></material>
      </visual>
      <collision>
        <geometry><mesh filename="package://sensors_description/meshes/roll_link.STL"/></geometry>
      </collision>
    </link>

    <link name="camera_link">
      <xacro:neck_part_inertial m="0.038"/>
      <visual>
        <geometry><mesh filename="package://sensors_description/meshes/camera_link.STL"/></geometry>
        <material name="neck_light"/>
      </visual>
      <collision>
        <geometry><mesh filename="package://sensors_description/meshes/camera_link.STL"/></geometry>
      </collision>
    </link>

    <joint name="horizontal_neck_joint" type="revolute">
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <parent link="${parent}"/>
      <child link="neck_pan_link"/>
      <axis xyz="0 0 1"/>
      <limit effort="1" lower="-1.57" upper="1.57" velocity="1"/>
    </joint>

    <joint name="vertical_neck_joint" type="revolute">
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <parent link="neck_pan_link"/>
      <child link="camera_mount_link"/>
      <axis xyz="0 1 0"/>
      <limit effort="1" lower="-1.57" upper="1.57" velocity="1"/>
    </joint>

    <joint name="camera_joint" type="fixed">
      <origin xyz="0.06705 0 -0.00425" rpy="0 0 0"/>
      <parent link="camera_mount_link"/>
      <child link="camera_link"/>
    </joint>

    <!-- Fixed reference chain (does not follow the neck) -->
    <link name="neck_pan_link_static"/>
    <link name="camera_mount_link_static"/>
    <link name="camera_link_static"/>

    <joint name="neck_pan_joint_static" type="fixed">
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <parent link="${parent}"/>
      <child link="neck_pan_link_static"/>
    </joint>
    <joint name="camera_mount_joint_static" type="fixed">
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <parent link="neck_pan_link_static"/>
      <child link="camera_mount_link_static"/>
    </joint>
    <joint name="camera_joint_static" type="fixed">
      <origin xyz="0.06705 0 -0.00425" rpy="0 0 0"/>
      <parent link="camera_mount_link_static"/>
      <child link="camera_link_static"/>
    </joint>

  </xacro:macro>

</robot>
