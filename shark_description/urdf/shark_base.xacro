<?xml version="1.0"?>
<!--
  Shark differential-drive base, parametrized by base_version.

  Geometry comes ONLY from config/<base_version>.yaml. Do not hardcode
  dimensions here. Usage:

    <xacro:include filename="$(find shark_description)/urdf/shark_base.xacro" />
    <xacro:shark_base/>

  and pass base_version:=v1|v2 to xacro (default v1).

  Frames: base_footprint -> base_link -> left_wheel / right_wheel.
  Joints: left_wheel_joint / right_wheel_joint (same names as ros2_control
  and the diff_drive_controller).
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="base_version" default="v1"/>
  <xacro:property name="shark_cfg" value="${xacro.load_yaml('$(find shark_description)/config/$(arg base_version).yaml')}"/>

  <xacro:include filename="$(find shark_description)/urdf/shark_materials.xacro" />

  <xacro:property name="base_len"          value="${shark_cfg['base']['length']}"/>
  <xacro:property name="base_width"        value="${shark_cfg['base']['width']}"/>
  <xacro:property name="base_height"       value="${shark_cfg['base']['height']}"/>
  <xacro:property name="wheel_radius"      value="${shark_cfg['wheel']['radius']}"/>
  <xacro:property name="wheel_width"       value="${shark_cfg['wheel']['width']}"/>
  <xacro:property name="wheel_separation"  value="${shark_cfg['wheel']['separation']}"/>
  <xacro:property name="wheel_x_offset"    value="${shark_cfg['wheel']['x_offset']}"/>
  <xacro:property name="caster_height"     value="${shark_cfg['caster_height']}"/>

  <xacro:macro name="box_inertia" params="m w h d">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m / 12.0 * (d*d + h*h)}" ixy="0.0" ixz="0.0" iyy="${m / 12.0 * (w*w + h*h)}" iyz="0.0" izz="${m / 12.0 * (w*w + d*d)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(3*r*r+h*h)/12}" ixy="0" ixz="0" iyy="${m*(3*r*r+h*h)/12}" iyz="0" izz="${m*r*r/2}"/>
    </inertial>
  </xacro:macro>

  <!-- reflect: +1 left (y > 0), -1 right (y < 0) -->
  <xacro:macro name="shark_wheel" params="prefix reflect">
    <link name="${prefix}_wheel">
      <visual>
        <material name="darkgray"/>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia m="10" r="${wheel_radius}" h="${wheel_width}"/>
    </link>

    <!-- The wheel axle sits at z = wheel_radius above the ground:
         base_link is at (base_height/2 + caster_height) above base_footprint. -->
    <joint name="${prefix}_wheel_joint" type="continuous">
      <axis xyz="0 1 0"/>
      <parent link="base_link"/>
      <child link="${prefix}_wheel"/>
      <origin xyz="${wheel_x_offset} ${reflect * wheel_separation / 2} ${wheel_radius - caster_height - base_height/2}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="shark_base">
    <link name="base_footprint"/>

    <link name="base_link">
      <xacro:box_inertia m="1" w="${base_len}" h="${base_width}" d="0.01"/>
      <visual>
        <material name="lightgray"/>
        <geometry>
          <box size="${base_len} ${base_width} ${base_height}"/>
        </geometry>
      </visual>
      <collision>
        <geometry>
          <box size="${base_len} ${base_width} ${base_height}"/>
        </geometry>
      </collision>
    </link>

    <joint name="base_link_joint" type="fixed">
      <origin xyz="0 0 ${base_height/2 + caster_height}" rpy="0 0 0"/>
      <parent link="base_footprint"/>
      <child link="base_link"/>
    </joint>

    <xacro:shark_wheel prefix="left"  reflect="1"/>
    <xacro:shark_wheel prefix="right" reflect="-1"/>
  </xacro:macro>

  <!-- ros2_control block (same config yaml, same joint names) -->
  <xacro:include filename="$(find shark_description)/ros2_control/shark_base_ros2_control.xacro" />

</robot>
