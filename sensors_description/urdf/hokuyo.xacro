<?xml version="1.0"?>
<robot name="sensor_hokuyo" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="sensor_hokuyo" params="parent xyz rpy name">
    <link name="hokuyo_${name}_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://sensors_description/meshes/hokuyo.dae"/>
        </geometry>
      </visual>
      <inertial>
        <mass value="1e-5" />
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6" />
      </inertial>
    </link>
    <joint name="hokuyo_${name}_joint" type="fixed">
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <parent link="${parent}"/>
      <child link="hokuyo_${name}_link"/>
    </joint>
    <xacro:sim_laser_range_finder name="${name}"/>
  </xacro:macro>

  <xacro:macro name="sim_laser_range_finder" params="name">
    <gazebo reference="hokuyo_${name}_link">
      <sensor type="gpu_lidar" name="hokuyo_${name}_sensor">
        <pose>0 0 0 0 0 0</pose>
        <topic>scan_${name}</topic>
        <ignition_frame_id>hokuyo_${name}_link</ignition_frame_id>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>20</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>683</samples>
              <resolution>1</resolution>
              <min_angle>-2.0943</min_angle>
              <max_angle>2.0943</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.15</min>
            <max>4.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </ray>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>
