<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fbot_description</name>
  <version>0.1.0</version>
  <description>
    BORIS robot description (data only): URDF/xacro, controller, EKF and sensor
    configs. The robot is STARTED from fbot_bringup/launch/robot.launch.py; this
    package only provides the model and a hardware-free display launch.
  </description>
  <maintainer email="richardjcassis@furg.br">fbot</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>shark_description</exec_depend>
  <exec_depend>sensors_description</exec_depend>
  <exec_depend>boris_head_description</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
