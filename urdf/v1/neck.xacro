<?xml version="1.0"?>
<!--
  BORIS neck + camera mount.

  fbot_hri/fbot_head `neck_controller` drives four Dynamixels from one command
  and publishes all of them on /boris_head/joint_states:
    head_pan_joint         (id 8,  about z)  camera pan   <- modeled here
    head_tilt_joint        (id 9,  about y)  camera tilt  <- modeled here
    horizontal_neck_joint  (id 62)           animatronic head (face), left/right
    vertical_neck_joint    (id 61)           animatronic head (face), up/down
  The camera sits on the pan/tilt motors, so only those move camera_link.
  The head motors follow the same command but carry no frame we use, so they
  are not modeled (their joint states are ignored by robot_state_publisher).

  Frames (parent -> child):
    <parent> -> head_pan_link -> head_tilt_link -> camera_link
  A second, FIXED copy of the chain ends at `camera_link_static`. It does not
  follow the neck and is used as a reference frame (neck_controller default
  target_frame, infinite_rotate_camera state).

  Usage:
    <xacro:include filename="$(find fbot_description)/urdf/v1/neck.xacro"/>
    <xacro:neck parent="dorso_link" xyz="..." rpy="0 0 0"/>

  NOTE: the facial joints (jaw, eyes, eyelids, eyebrows) are driven by
  fbot_head emotions_bridge (Arduino) and have no joint-state feedback, so
  they are intentionally not part of this description. The face meshes under
  meshes/face are still used by fbot_simulation/models/boris.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="neck_part_inertial" params="m">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="1.0e-5" ixy="0" ixz="0" iyy="1.0e-5" iyz="0" izz="1.0e-5"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="neck" params="parent xyz rpy">

    <!-- Moving chain -->
    <link name="head_pan_link">
      <xacro:neck_part_inertial m="0.018"/>
      <visual>
        <geometry><mesh filename="package://fbot_description/meshes/neck/tilt_link.STL"/></geometry>
        <material name="neck_dark"><color rgba="0.25 0.25 0.25 1"/></material>
      </visual>
      <collision>
        <geometry><mesh filename="package://fbot_description/meshes/neck/tilt_link.STL"/></geometry>
      </collision>
    </link>

    <link name="head_tilt_link">
      <xacro:neck_part_inertial m="0.055"/>
      <visual>
        <geometry><mesh filename="package://fbot_description/meshes/neck/roll_link.STL"/></geometry>
        <material name="neck_light"><color rgba="0.79 0.82 0.93 1"/></material>
      </visual>
      <collision>
        <geometry><mesh filename="package://fbot_description/meshes/neck/roll_link.STL"/></geometry>
      </collision>
    </link>

    <link name="camera_link">
      <xacro:neck_part_inertial m="0.038"/>
      <visual>
        <geometry><mesh filename="package://fbot_description/meshes/neck/camera_link.STL"/></geometry>
        <material name="neck_light"/>
      </visual>
      <collision>
        <geometry><mesh filename="package://fbot_description/meshes/neck/camera_link.STL"/></geometry>
      </collision>
    </link>

    <joint name="head_pan_joint" type="revolute">
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <parent link="${parent}"/>
      <child link="head_pan_link"/>
      <axis xyz="0 0 1"/>
      <limit effort="1" lower="-1.57" upper="1.57" velocity="1"/>
    </joint>

    <joint name="head_tilt_joint" type="revolute">
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <parent link="head_pan_link"/>
      <child link="head_tilt_link"/>
      <axis xyz="0 1 0"/>
      <limit effort="1" lower="-1.57" upper="1.57" velocity="1"/>
    </joint>

    <joint name="camera_joint" type="fixed">
      <origin xyz="0.06705 0 -0.00425" rpy="0 0 0"/>
      <parent link="head_tilt_link"/>
      <child link="camera_link"/>
    </joint>

    <!-- Camera drivers: each publishes its own tree rooted at <camera_name>_link
         (fbot_bringup/camera.launch.py: camera_name femtobolt / realsense).
         Attach both roots to camera_link so point clouds and detections follow
         the pan/tilt. Zero offset = the pre-2026-04 setup, where camera_name was
         'camera' and the driver root WAS camera_link. Only one camera runs at a
         time; the other frame is simply unused. -->
    <link name="femtobolt_link"/>
    <joint name="femtobolt_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="camera_link"/>
      <child link="femtobolt_link"/>
    </joint>

    <link name="realsense_link"/>
    <joint name="realsense_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="camera_link"/>
      <child link="realsense_link"/>
    </joint>

    <!-- Fixed reference chain (does not follow the neck) -->
    <link name="head_pan_link_static"/>
    <link name="head_tilt_link_static"/>
    <link name="camera_link_static"/>

    <joint name="head_pan_joint_static" type="fixed">
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <parent link="${parent}"/>
      <child link="head_pan_link_static"/>
    </joint>
    <joint name="head_tilt_joint_static" type="fixed">
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <parent link="head_pan_link_static"/>
      <child link="head_tilt_link_static"/>
    </joint>
    <joint name="camera_joint_static" type="fixed">
      <origin xyz="0.06705 0 -0.00425" rpy="0 0 0"/>
      <parent link="head_tilt_link_static"/>
      <child link="camera_link_static"/>
    </joint>

  </xacro:macro>

</robot>
