<?xml version="1.0"?>
<!--
  BORIS v2: body, sensors, neck and arm mount. Every pose comes from
  config/robot/v2.yaml (base_cfg), generated by tools/v2_from_onshape.py from the
  Onshape export. Included by boris.urdf.xacro (robot_version:=v2).

  Frames: base_link -> dorso_link -> neck (urdf/v2/neck.xacro)
          base_link -> arm_mount_link (xArm base, on the base top)
          base_link -> hokuyo_ground_link, hokuyo_back_link, sick_mount_link, imu_link
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find fbot_description)/urdf/sensors/hokuyo.xacro"/>
  <xacro:include filename="$(find fbot_description)/urdf/sensors/sick_lms1xx.xacro"/>
  <xacro:include filename="$(find fbot_description)/urdf/v2/neck.xacro"/>

  <xacro:property name="body"    value="${base_cfg['body']}"/>
  <xacro:property name="sensors" value="${base_cfg['sensors']}"/>

  <!-- torso: frame at the bottom centre of the box -->
  <xacro:property name="dorso" value="${body['dorso']}"/>
  <link name="dorso_link">
    <xacro:box_inertia m="8" w="${dorso['width']}" h="${dorso['height']}" d="${dorso['length']}"/>
    <visual>
      <origin xyz="0 0 ${dorso['height'] / 2}"/>
      <material name="lightgray"/>
      <geometry><box size="${dorso['length']} ${dorso['width']} ${dorso['height']}"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 ${dorso['height'] / 2}"/>
      <geometry><box size="${dorso['length']} ${dorso['width']} ${dorso['height']}"/></geometry>
    </collision>
  </link>
  <joint name="dorso_joint" type="fixed">
    <parent link="base_link"/>
    <child link="dorso_link"/>
    <origin xyz="${dorso['xyz'][0]} ${dorso['xyz'][1]} ${dorso['xyz'][2]}" rpy="0 0 0"/>
  </joint>

  <!-- arm mount: bottom centre of the xArm base (manipulator.launch.py attaches the arm here) -->
  <xacro:if value="$(arg use_arm_mount)">
    <xacro:property name="arm" value="${body['arm_mount']}"/>
    <link name="arm_mount_link"/>
    <joint name="arm_mount_joint" type="fixed">
      <parent link="base_link"/>
      <child link="arm_mount_link"/>
      <origin xyz="${arm['xyz'][0]} ${arm['xyz'][1]} ${arm['xyz'][2]}"
              rpy="${arm['rpy'][0]} ${arm['rpy'][1]} ${arm['rpy'][2]}"/>
    </joint>
  </xacro:if>

  <xacro:if value="$(arg use_neck)">
    <xacro:neck_v2 parent="dorso_link"/>
  </xacro:if>

  <!-- Hokuyos (frame names must match config/sensors/urg_*.yaml) -->
  <xacro:macro name="v2_hokuyo" params="key name">
    <xacro:property name="h" value="${sensors[key]}"/>
    <xacro:sensor_hokuyo parent="base_link" name="${name}" mesh="${h['mesh']}"
        xyz="${h['xyz'][0]} ${h['xyz'][1]} ${h['xyz'][2]}" rpy="${h['rpy'][0]} ${h['rpy'][1]} ${h['rpy'][2]}"/>
  </xacro:macro>
  <xacro:v2_hokuyo key="hokuyo_ground" name="ground"/>
  <xacro:v2_hokuyo key="hokuyo_back" name="back"/>

  <xacro:if value="$(arg use_sick)">
    <xacro:property name="sick" value="${sensors['sick']}"/>
    <xacro:sick_lms_1xx name="sick" ros_topic="/scan"/>
    <joint name="laser_joint" type="fixed">
      <origin xyz="${sick['xyz'][0]} ${sick['xyz'][1]} ${sick['xyz'][2]}" rpy="${sick['rpy'][0]} ${sick['rpy'][1]} ${sick['rpy'][2]}"/>
      <parent link="base_link"/>
      <child link="sick_mount_link"/>
    </joint>
  </xacro:if>

  <!-- IMU (not in the CAD yet: see `todo` in the yaml). bno055 frame_id must be imu_link -->
  <xacro:property name="imu" value="${sensors['imu']}"/>
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="${imu['xyz'][0]} ${imu['xyz'][1]} ${imu['xyz'][2]}" rpy="${imu['rpy'][0]} ${imu['rpy'][1]} ${imu['rpy'][2]}"/>
  </joint>

</robot>
